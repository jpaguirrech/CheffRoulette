# Neon Postgres connection string. Use the POOLED endpoint
# (host contains "-pooler") for the runtime app — postgres-js opens
# and closes connections frequently and benefits from PgBouncer.
# Use the DIRECT endpoint only for drizzle-kit migrations if needed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Application
NODE_ENV="development"
PORT=5000

# Session (Express session middleware, current Passport flow).
# Replaced by Firebase Auth in pivot Phase 4.
SESSION_SECRET="generate-a-long-random-string"

# Google OAuth (current Passport flow). Remove after Phase 4.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Recipe extraction webhook (3rd-party, writes directly to DATABASE_URL).
# Override only if pointing at a staging instance of the partner workflow.
# WEBHOOK_URL="https://flw.panteragpt.com/webhook/social-media-recipe"
# WEBHOOK_TOKEN=""

# Firebase (Phase 4+, not used yet)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# FIREBASE_ADMIN_SA_JSON=""
